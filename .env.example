# Public URL of the app (used for auth callbacks and links in emails)
BETTER_AUTH_URL=http://localhost:3000
# e.g. https://seatbit.bitsandbricks.ch in production
# Random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me

# SQLite file (default: ./data/lan.db)
# DATABASE_PATH=./data/lan.db

# Comma-separated emails that become admins on sign-up (the first user is always admin)
ADMIN_EMAILS=

# Discord login: https://discord.com/developers/applications
# Redirect URL: ${BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google login: https://console.cloud.google.com/apis/credentials
# Redirect URL: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (reminders, password reset). Without SMTP_URL, mails are printed to the console.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Seatbit <lan@example.com>"

# Built-in reminder check interval in minutes (0 = off, use /api/cron/reminders instead)
REMINDER_INTERVAL_MINUTES=60
# Bearer token for GET /api/cron/reminders
CRON_SECRET=

# Timezone used for dates in forms and emails
TZ=Europe/Zurich
