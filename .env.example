# Public URL of the app (used for auth callbacks and links in emails)
BETTER_AUTH_URL=http://localhost:3000
# e.g. https://seatbit.bitsandbricks.ch in production
# Random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me

# Everything below BETTER_AUTH_SECRET/DATABASE_PATH can also be set by an admin at
# /admin/settings; values saved there override these env vars.
# Key for encrypting secrets saved in the admin settings (default: derived from BETTER_AUTH_SECRET)
# SETTINGS_ENCRYPTION_KEY=

# SQLite file (default: ./data/lan.db)
# DATABASE_PATH=./data/lan.db

# Allow new accounts (true/false, default true)
# SIGNUP_OPEN=true
# Comma-separated emails that become admins on sign-up (the first user is always admin)
ADMIN_EMAILS=

# Discord login: https://discord.com/developers/applications
# Redirect URL: ${BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord bot (same app as the login). See README "Discord bot".
# Interactions Endpoint URL: ${BETTER_AUTH_URL}/api/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Google login: https://console.cloud.google.com/apis/credentials
# Redirect URL: ${BETTER_AUTH_URL}/api/auth/callback/google
# Google login is switched off in code for now (LOGIN_METHODS in src/lib/auth.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (reminders, password reset). Without an SMTP host, mails are printed to the console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls | tls | none
# SMTP_USER=
# SMTP_PASSWORD=
# Or, as before, a single URL (used only when no SMTP host is set):
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Seatbit <lan@example.com>"
# Currency shown on food orders (default CHF; also in Admin → Platform settings)
FOOD_CURRENCY=

# Built-in reminder check interval in minutes (0 = off, use /api/cron/reminders instead)
REMINDER_INTERVAL_MINUTES=60
# Bearer token for GET /api/cron/reminders
CRON_SECRET=

# Operator of this instance, shown on /terms and /privacy (or set them in Admin → Platform settings → Operator & legal)
# LEGAL_OPERATOR_NAME="Jane Doe"
# LEGAL_OPERATOR_ADDRESS="Example Street 1, 8000 Zurich, Switzerland"
# LEGAL_CONTACT_EMAIL=privacy@example.com
# LEGAL_HOSTING_LOCATION=Switzerland
# LEGAL_GOVERNING_LAW="Swiss law"
# Link your own documents instead of the built-in ones:
# LEGAL_TERMS_URL=https://example.com/terms
# LEGAL_PRIVACY_URL=https://example.com/privacy
# Footer "Source" link; point it to your fork if you changed the code (AGPL)
# SOURCE_URL=https://github.com/bitsandbricks-ch/seatbit

# Timezone used for dates in forms and emails
TZ=Europe/Zurich

# Email & password login, off by default (Discord only). Set to 1 for local development and tests.
ALLOW_EMAIL_LOGIN=
