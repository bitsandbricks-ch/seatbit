# Copy to secrets.env (git-ignored), fill in, then:
#   kubectl -n seatbit create secret generic seatbit-secrets --from-env-file=secrets.env
# Only BETTER_AUTH_SECRET and CRON_SECRET are required; the rest can also be
# entered later in the app under Admin -> Platform settings.

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 24
CRON_SECRET=
ADMIN_EMAILS=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
